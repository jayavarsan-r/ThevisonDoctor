NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SHOW_DRAFTS=false            # true on preview deployments only
NEXT_PUBLIC_GA_ID=                       # optional GA4; consent required
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=            # optional alternative to GA4
SMTP_USER=                               # Gmail address that sends enquiries, e.g. thevisiondoctor6.6@gmail.com
SMTP_PASS=                               # Google "app password" for that account (not the normal password)
RESEND_API_KEY=                          # optional alternative to SMTP
ENQUIRY_TO_EMAIL=thevisiondoctor6.6@gmail.com
ENQUIRY_FROM_EMAIL=
SHEETS_WEBHOOK_URL=                      # optional Google Apps Script webhook to append leads
TURNSTILE_SITE_KEY=                      # optional Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
